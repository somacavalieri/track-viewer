# Copie para .env.local e preencha com os valores do console do Neon.
# Sem estes valores o app roda em modo local (IndexedDB apenas, sem login/sync).

# Neon → seu projeto → branch → aba "Data API" → URL do endpoint REST
VITE_NEON_DATA_API_URL=https://ep-xxxx-xxxx.apirest.sa-east-1.aws.neon.tech/neondb/rest/v1

# Neon → seu projeto → aba "Auth" (Neon Auth) → configuração do app
VITE_STACK_PROJECT_ID=
VITE_STACK_PUBLISHABLE_CLIENT_KEY=
